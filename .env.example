# Ambit configuration. Copy to `.env` and fill in.
#
# Only MONGODB_URI is required. Everything else selects a capability, and its
# absence is reported at GET /health rather than failing silently.

# --- required -------------------------------------------------------------
# Atlas specifically: $vectorSearch is an Atlas-only aggregation stage, so a
# self-hosted mongod cannot serve the premise of this project.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gridsight

# --- corpus ingest --------------------------------------------------------
# Hugging Face token for the VisA / MVTec parquet downloads. Unauthenticated
# access works but rate-limits sooner.
HF_TOKEN=

# --- text LLM: ambiguous-band adjudication and model naming ---------------
# With neither key set, the 0.04 ambiguous band resolves by the deterministic
# rule -- refuse -- which is the correct default and needs no credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# openai | openrouter | none. Unset picks OpenAI if its key is present.
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# --- vision LLM: describing what physically differs -----------------------
# Absent, narration falls back to the sentence written from the numbers and the
# finding records narrative_source: "structured".
FIREWORKS_API_KEY=
# fireworks | local | none. Unset picks Fireworks if its key is present, then a
# locally cached vision model, then none.
VLM_PROVIDER=
# Overrides the measured primary without a code change.
VLM_MODEL=
# Seconds. Measured provider latency is 2.1-5.0 s, so 4 s discards about half
# of all good descriptions.
VLM_TIMEOUT_S=8

# --- voice ----------------------------------------------------------------
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# --- routing --------------------------------------------------------------
# A global floor beneath every model's own coverage gate, never a relaxation of
# it. The gate is what does the work; this only stops a near-empty registry from
# accepting anything at all.
ROUTE_THRESHOLD=0.82
VECTOR_INDEX_NAME=model_router_idx
RECALL_INDEX_NAME=finding_recall_idx

# --- web ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
